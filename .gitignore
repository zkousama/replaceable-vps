# Local values and state. Everything here either identifies somebody or can
# log in as them.
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
crash.log

# .terraform.lock.hcl is NOT here on purpose. It pins the exact provider
# versions and their hashes, which is the difference between everyone getting
# the same providers and everyone getting whatever was newest that morning.

infra/ansible/inventory.ini
infra/ansible/group_vars/all.yml
*.retry

# Editor and OS noise
.DS_Store
*.swp
