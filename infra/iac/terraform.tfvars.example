# Copy to terraform.tfvars, which is gitignored.

server_name     = "prod"
server_type     = "cx22"
server_location = "nbg1"
server_image    = "ubuntu-24.04"

ssh_key_name = "ops-primary"

# The port sshd ends up on, and whether 22 stays open beside it. Flip the
# second one to false once the bootstrap playbook has run.
ssh_port               = 2202
allow_default_ssh_port = true

ssh_source_cidrs = ["203.0.113.4/32"]

cloudflare_zone_id = "<zone id>"
a_records          = ["@", "www", "api"]
aaaa_records       = ["@", "www", "api"]
