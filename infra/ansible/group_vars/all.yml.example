# Copy to all.yml, which is gitignored: the key and the CIDRs are specific to
# whoever runs this.

ops_user: ops

# Public key that gets to log in as ops. A path on the machine running Ansible,
# not the key material, so a rotation is a file change rather than an edit
# here.
ops_public_key_file: ~/.ssh/id_ed25519_ops.pub

# Where sshd listens after bootstrap. Moving it off 22 stops nothing
# determined, it just empties the logs of the untargeted scanning that makes
# real attempts hard to see. Keep the cloud firewall in front either way.
ssh_port: 2222

# Who may reach that port at the host firewall. The cloud firewall says the
# same thing one layer out; this is what is left if that is ever misconfigured.
ssh_allowed_cidrs:
  - 203.0.113.4/32

timezone: Etc/UTC

# Docker's default is unbounded JSON logs, which is how a disk fills up 8
# months after anybody last looked at it.
docker_log_max_size: 10m
docker_log_max_file: "3"
